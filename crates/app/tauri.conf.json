{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArduTune",
  "identifier": "app.ardutune.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArduTune",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Diagnose and tune ArduPilot multicopters from flight logs",
    "publisher": "Yevhen Vydolob",
    "copyright": "Copyright © 2026 Yevhen Vydolob. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/evidolob/ardutune",
    "longDescription": "ArduTune helps set up, diagnose and tune ArduPilot multicopters: setup guide, motor and compass checks, serial ports, RC, GPS, AutoTune preparation, and filter and PID recommendations from flight logs. Works offline.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
