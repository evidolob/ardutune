{
  "name": "ArduTune",
  "short_name": "ArduTune",
  "description": "Analyse ArduPilot flight logs: readiness, noise, filters, PIDs and crash diagnosis. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1218",
  "theme_color": "#0f1218",
  "icons": [
    { "src": "icons/128x128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/128x128@2x.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/octet-stream": [".bin"] } }]
}
